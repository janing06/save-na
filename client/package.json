{
	"name": "client",
	"main": "expo-router/entry",
	"version": "1.0.0",
	"scripts": {
		"start": "expo start",
		"reset-project": "node ./scripts/reset-project.js",
		"android": "expo start --android",
		"ios": "expo start --ios",
		"web": "expo start --web",
		"lint": "biome lint --diagnostic-level=error --no-errors-on-unmatched",
		"lint:fix": "biome check --fix --no-errors-on-unmatched",
		"format": "biome format --write --no-errors-on-unmatched",
		"ts:check": "tsc --noEmit",
		"fsd": "steiger ./src",
		"knip": "knip -c knip.config.jsonc --no-config-hints",
		"check-all": "npm run ts:check && npm run lint && npm run lint:fix && npm run format && npm run fsd && npm run knip"
	},
	"dependencies": {
		"@expo-google-fonts/plus-jakarta-sans": "^0.4.2",
		"@ronradtke/react-native-markdown-display": "^8.1.0",
		"@tanstack/react-query": "^5.95.0",
		"expo": "~54.0.33",
		"expo-constants": "~18.0.13",
		"expo-font": "~14.0.11",
		"expo-linking": "~8.0.11",
		"expo-local-authentication": "~17.0.8",
		"expo-notifications": "~0.32.16",
		"expo-router": "~6.0.23",
		"expo-splash-screen": "~31.0.13",
		"expo-sqlite": "~16.0.10",
		"expo-system-ui": "~6.0.9",
		"expo-updates": "~29.0.16",
		"jotai": "^2.18.1",
		"nativewind": "^4.2.3",
		"react": "19.1.0",
		"react-dom": "19.1.0",
		"react-native": "0.81.5",
		"react-native-gesture-handler": "~2.28.0",
		"react-native-reanimated": "~4.1.1",
		"react-native-safe-area-context": "~5.6.0",
		"react-native-screens": "~4.16.0",
		"react-native-svg": "15.12.1",
		"react-native-web": "~0.21.0",
		"tailwindcss": "^3.4.19"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.4.8",
		"@feature-sliced/steiger-plugin": "^0.5.7",
		"@types/react": "~19.1.0",
		"knip": "^6.0.1",
		"steiger": "^0.5.11",
		"typescript": "~5.9.2"
	},
	"private": true
}
