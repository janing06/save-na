{
	"cli": {
		"version": ">= 16.0.0"
	},
	"build": {
		"development": {
			"developmentClient": true,
			"distribution": "internal",
			"env": {
				"APP_ENV": "development"
			}
		},
		"preview": {
			"android": {
				"buildType": "apk"
			},
			"ios": {
				"simulator": true
			},
			"distribution": "internal",
			"channel": "preview",
			"env": {
				"APP_ENV": "preview"
			}
		},
		"production": {
			"android": {
				"buildType": "app-bundle"
			},
			"distribution": "store",
			"channel": "production",
			"env": {
				"APP_ENV": "production"
			}
		}
	}
}
